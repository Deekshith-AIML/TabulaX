# TabulaX backend configuration (copy to .env for local development).
# Every value can also be provided as a plain environment variable.
# .env is gitignored — NEVER commit real secrets.

# --- Core ---
ENVIRONMENT=development

# --- Security ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left empty, an ephemeral random key is generated on boot (tokens then
# invalidate on restart — fine for dev, NOT for production).
SECRET_KEY=change-me-to-a-random-token-urlsafe-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
MIN_PASSWORD_LENGTH=8

# --- MongoDB ---
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=tabula

# --- CORS (comma-separated allowed origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (OPTIONAL) ---
# Leave OPENAI_API_KEY empty to disable the AI assistant entirely.
# Deterministic transformations (case, numbers, dates, base64, roman numerals,
# saved lookups) keep working without a key.
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
# Provider selection: openai (default), ollama (local/free), or none.
LLM_PROVIDER=openai
# Used when LLM_PROVIDER=ollama. No API key needed; pull the model first:
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Data / session limits ---
MAX_UPLOAD_BYTES=52428800
MAX_ROWS_PER_DATASET=200000
SESSION_TTL_MINUTES=720
PREVIEW_ROWS=100

# --- Sandbox resource limits ---
# Bounds the HEAP (not virtual address space) available to transformation code,
# and the wall-clock time per request. Enforced on Linux only.
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEMORY_LIMIT_MB=512
